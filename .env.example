# Copy to .env in the project root and fill in the values. Never commit .env.
# Every setting can be left empty; empty means the default noted beside it.
#
# There is no frontend build. The browser receives only the values listed
# under PUBLIC, and only because the server writes them into pages.
# Everything under PRIVATE stays inside the server process.

# ---------------------------------------------------------------------------
# PUBLIC: safe to appear in pages sent to browsers
# ---------------------------------------------------------------------------

# Public https origin, for example https://www.example.com. Used for the
# same-origin check, share tags, and HSTS. Required in production.
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile site key. Optional; see TURNSTILE_SECRET.
TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# PRIVATE: server only. Never place these in HTML, assets/, or browser code.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Required.
DATABASE_URL=

# Isolated local database used only by `npm run db:migrate:test` and
# `npm run test:integration`. Use a localhost URL and a database name ending in _test.
TEST_DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5434/nubetree_test

# Local Docker database only (docker-compose.yml). Not used in production.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Google Calendar OAuth for the team calendar. Required for booking.
CALENDAR_PROVIDER=
CALENDAR_CLIENT_ID=
CALENDAR_CLIENT_SECRET=
CALENDAR_REFRESH_TOKEN=
CALENDAR_ID=
# Shared secret for /api/webhooks/calendar. Optional.
CALENDAR_WEBHOOK_SECRET=

# Resend. Required for booking and contact email.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
INTERNAL_NOTIFICATION_EMAIL=
EMAIL_ACKNOWLEDGE=

# Salesforce Connected App using the client-credentials OAuth flow. Required in production.
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# A unique Text (64) Lead field marked External ID. Change this for a custom API name.
SALESFORCE_EXTERNAL_ID_FIELD=Website_External_Id__c
SALESFORCE_API_VERSION=61.0
# Local development only: set true to require Salesforce locally. Production always requires it.
SALESFORCE_REQUIRED=

# Cloudflare Turnstile secret. Turnstile turns on only when both this and
# TURNSTILE_SITE_KEY are set.
TURNSTILE_SECRET=

# Server
PORT=
HOST=
# Set true only when requests reach the app through a trusted proxy that sets X-Forwarded-For.
TRUST_PROXY=

# Booking rules
BOOKING_TIMEZONE=
BOOKING_WORK_START=
BOOKING_WORK_END=
BOOKING_WEEKDAYS=
BOOKING_DURATION_MINUTES=
BOOKING_BUFFER_MINUTES=
BOOKING_HORIZON_DAYS=
BOOKING_MIN_LEAD_MINUTES=

# Failure alerts: a Slack, Discord, or Teams incoming webhook. Recommended.
ALERT_WEBHOOK_URL=

# Abuse protection
RATE_LIMIT_MAX_REQUESTS=
RATE_LIMIT_AVAILABILITY_MAX=
RATE_LIMIT_WINDOW_SECONDS=
HONEYPOT_ENABLED=
